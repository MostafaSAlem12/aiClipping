# Application
APP_NAME=AI Video Engine
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Paths (relative paths resolve from project root)
DATA_DIR=data
DATABASE_URL=sqlite:///./data/app.db

# External tools (leave empty to use PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Ollama — pull a model first, then set the exact name from `ollama list`
# Examples after pull: llama3.1:8b, qwen2.5:14b, mistral:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=300

# Transcription (faster-whisper model size)
# Options: tiny, base, small, medium, large-v2, large-v3, distil-large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=

# Clip selection
MAX_CLIPS_PER_VIDEO=5
MIN_CLIP_DURATION=10.0
MAX_CLIP_DURATION=90.0
PREFERRED_MIN_DURATION=20.0
PREFERRED_MAX_DURATION=90.0
MIN_CANDIDATE_SCORE=6.0

# Rendering
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
SUBTITLE_FONT_SIZE=48
